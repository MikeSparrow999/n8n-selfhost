# /opt/n8n/.env  — copy from env.example, fill in, then: chmod 600 .env
# Never commit this file. Everything marked GENERATE comes from:  openssl rand -hex 32

# ---- versions (pinned 3 Sep 2026; bump only via the runbook upgrade procedure)
N8N_VERSION=2.37.9
CLOUDFLARED_VERSION=2026.8.3
POSTGRES_VERSION=16-alpine

# ---- public identity
N8N_HOST=n8n.thinkrep.com
TZ=Europe/London

# ---- Postgres
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=GENERATE

# ---- n8n
# Encrypts every credential at rest. LOSE THIS = LOSE ALL CREDENTIALS. Back it up
# separately from the server (password manager). It must never change once set.
N8N_ENCRYPTION_KEY=GENERATE

# ---- Cloudflare Tunnel
# From Zero Trust -> Networks -> Tunnels -> <tunnel> -> Configure -> the token in the
# `cloudflared ... run <token>` command. Long base64 string starting with "eyJ".
CLOUDFLARE_TUNNEL_TOKEN=

# ---- backup.sh
BACKUP_DIR=/opt/n8n/backups
RCLONE_REMOTE=r2:n8n-backups
# The R2 API token is IP-restricted to this VPS's IPv4. The box also has IPv6 and rclone would
# otherwise use it at random -> intermittent 403/501. Pin outbound rclone traffic to the IPv4.
RCLONE_BIND=185.194.218.192
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30
# optional: Telegram alert on backup failure (reuse the Error Logger bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
